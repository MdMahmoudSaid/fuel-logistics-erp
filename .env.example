# Copy to .env and adjust for your local setup. Never commit the real .env.

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fuel_erp
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fuel_erp

# Django
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
