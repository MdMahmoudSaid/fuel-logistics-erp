# Copy to .env on the production server and fill in real, unique values.
# Never commit the real .env — see .gitignore.
#
# Usage on the server:
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yml up --build -d

# Database — pick a strong, unique password (e.g. `openssl rand -base64 32`)
DB_USER=fuel_erp_prod
DB_PASSWORD=CHANGE_ME
DB_NAME=fuel_erp

# Django — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=your-domain.example.com
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# Ports exposed on the host (optional, defaults shown)
BACKEND_PORT=8000
FRONTEND_PORT=80
